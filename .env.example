# =============================================================================
# BigCommerce <-> Kickflip Import App — environment configuration
#
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit `.env`. All values below are placeholders.
#
# Store-specific secrets (BigCommerce access tokens, Kickflip API tokens) are
# NEVER kept here — they are stored encrypted in PostgreSQL, per store.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=https://example.ngrok-free.app
PORT=3000
LOG_LEVEL=info

# --- BigCommerce app credentials (from the Developer Portal draft app) -------
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=
BIGCOMMERCE_AUTH_CALLBACK_URL=https://example.ngrok-free.app/api/bigcommerce/auth
BIGCOMMERCE_LOAD_CALLBACK_URL=https://example.ngrok-free.app/api/bigcommerce/load
BIGCOMMERCE_UNINSTALL_CALLBACK_URL=https://example.ngrok-free.app/api/bigcommerce/uninstall
BIGCOMMERCE_REMOVE_USER_CALLBACK_URL=https://example.ngrok-free.app/api/bigcommerce/remove-user

# Space-separated OAuth scope identifiers this app requests. Keep to the
# minimum required. "store_v2_products" corresponds to "Products: modify".
# "store_v2_content" is required for Script Manager registration (the
# storefront Customize widget, src/lib/bigcommerce/scripts.ts). "store_v2_orders_read_only"
# is required for the Orders sync webhook (src/lib/bigcommerce/orders.ts). FLAG: both exact
# scope identifiers are unverified guesses, confirm against the BigCommerce Developer
# Portal's OAuth Scopes list (see docs/api-assumptions.md).
BIGCOMMERCE_APP_SCOPES=store_v2_products store_v2_content store_v2_orders_read_only

# Rarely need to change — override only for testing against a sandbox proxy.
BIGCOMMERCE_LOGIN_BASE_URL=https://login.bigcommerce.com
BIGCOMMERCE_API_BASE_URL=https://api.bigcommerce.com

# --- Database ------------------------------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL=postgresql://kickflip_app:changeme@localhost:5544/kickflip_app?schema=public
# Direct (non-pooled) connection string used by Prisma Migrate. May be the
# same as DATABASE_URL when not using an external connection pooler.
DIRECT_DATABASE_URL=postgresql://kickflip_app:changeme@localhost:5544/kickflip_app?schema=public
#
# --- Local-dev-only alternative: SQLite, no Docker/Postgres needed ---------
# Set DATABASE_URL to a `file:` URL instead and the app automatically
# switches to the SQLite backend (src/server/db/provider.ts) — a hand-built
# job queue replaces pg-boss (which is Postgres-only) for this path. See
# docs/architecture.md#sqlite-local-dev-path. Forbidden in production
# (NODE_ENV=production refuses to boot with a `file:` DATABASE_URL).
# Requires: pnpm db:generate:sqlite && pnpm db:migrate:sqlite (once).
# DATABASE_URL=file:./local.db
# DIRECT_DATABASE_URL is unused in SQLite mode.

# --- Secrets / crypto ----------------------------------------------------------
# 32-byte key, base64-encoded (`openssl rand -base64 32`). Used for
# AES-256-GCM encryption of stored BigCommerce/Kickflip tokens.
MASTER_ENCRYPTION_KEY=
# 32+ byte random secret (`openssl rand -base64 48`). Used to sign short-lived
# internal application sessions (HS256 JWT).
APP_SESSION_SIGNING_KEY=
# Minutes before an internal app session expires and requires reload via BC.
APP_SESSION_TTL_MINUTES=15

# --- Kickflip ------------------------------------------------------------------
# Confirmed live: https://api.gokickflip.com/v1/designs and the legacy
# https://api.mycustomizer.com/v1/designs alias both route to the same
# backend (identical auth + error responses) — gokickflip.com is the
# current-branded host, use it going forward.
KICKFLIP_API_BASE_URL=https://api.gokickflip.com/v1
# Comma-separated hostname allowlist for downloading design images.
# Sub-domains are NOT implicitly trusted — list each hostname explicitly.
# Placeholder hosts below — replace with the real CDN host(s) your Kickflip
# design image URLs actually use (check an image URL from a real design
# once your subscription is active; update this before importing for real).
KICKFLIP_ALLOWED_IMAGE_HOSTS=cdn.gokickflip.com,images.gokickflip.com
# URL *template* (not a bare URL) used to suggest a per-product Customize URL
# when a product has a known Kickflip customizer product id — the literal
# token {customizerProductId} is substituted in. Leave blank to disable the
# suggestion (merchants can still type a Customize URL manually either way).
# FLAG: this pattern is a guess, not confirmed against real Kickflip
# customizer docs — see docs/api-assumptions.md.
KICKFLIP_CUSTOMIZER_BASE_URL=

# --- HTTP client tuning ----------------------------------------------------
HTTP_CONNECT_TIMEOUT_MS=5000
HTTP_REQUEST_TIMEOUT_MS=30000

# --- Import engine ---------------------------------------------------------
IMPORT_GLOBAL_CONCURRENCY=5
IMPORT_PER_STORE_CONCURRENCY=2
IMPORT_MAX_ATTEMPTS=5
MAX_BATCH_IMPORT_SIZE=50
IMAGE_MAX_BYTES=8388608
IMAGE_MAX_REDIRECTS=3
IMAGE_MAX_PER_DESIGN=8

# --- Data retention ----------------------------------------------------------
# Days that audit logs and import run history are retained after a store
# uninstalls before they become eligible for permanent deletion.
DATA_RETENTION_DAYS=365

# --- Rate limiting (sensitive endpoints) --------------------------------------
RATE_LIMIT_SENSITIVE_WINDOW_MS=60000
RATE_LIMIT_SENSITIVE_MAX=10

# --- Rate limiting (public storefront widget config endpoint) ------------------
# Looser than the sensitive-endpoint limits above — this is hit on ordinary
# storefront page views, not rare admin actions.
RATE_LIMIT_STOREFRONT_WINDOW_MS=60000
RATE_LIMIT_STOREFRONT_MAX=120

# --- Rate limiting (public Orders webhook receiver) -----------------------------
# Keyed by storeHash rather than caller IP (the caller is BigCommerce's own
# shared infrastructure, not an end-user browser).
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=60

# --- Optional observability integrations --------------------------------------
# Leave blank to disable. The app must function fully without either.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Development-only mock mode -----------------------------------------------
# When "true", the app serves deterministic local fixtures instead of calling
# the real Kickflip/BigCommerce APIs. Refuses to start when NODE_ENV=production.
MOCK_MODE=false
