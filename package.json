{
  "name": "bigcommerce-kickflip-import-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "worker:dev": "tsx watch src/jobs/worker.ts",
    "build": "next build",
    "start": "next start",
    "worker:start": "tsx src/jobs/worker.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate:sqlite": "prisma generate --config prisma.sqlite.config.ts",
    "db:migrate:sqlite": "prisma migrate dev --config prisma.sqlite.config.ts",
    "db:migrate:deploy:sqlite": "prisma migrate deploy --config prisma.sqlite.config.ts",
    "db:studio:sqlite": "prisma studio --config prisma.sqlite.config.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "node -e \"process.exit(0)\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@bigcommerce/big-design": "3.3.0",
    "@bigcommerce/big-design-icons": "1.10.0",
    "@bigcommerce/big-design-theme": "1.3.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "jose": "6.2.5",
    "next": "16.2.12",
    "pg-boss": "12.26.3",
    "pino": "10.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "2.17.6",
    "styled-components": "5.3.11",
    "tsx": "4.23.1",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/sanitize-html": "2.16.1",
    "@types/styled-components": "5.1.36",
    "@vitejs/plugin-react": "6.0.5",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
